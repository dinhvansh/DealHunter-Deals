DEALHUNTER_ENV=local
DEALHUNTER_DATABASE_URL=postgresql+psycopg://dealhunter:dealhunter@postgres:5432/dealhunter
DEALHUNTER_REDIS_URL=redis://redis:6379/0

DEALHUNTER_SHOPEE_BASE_URL=https://shopee.vn
DEALHUNTER_SHOPEE_TRANSPORT=http
DEALHUNTER_SHOPEE_TIMEOUT_SECONDS=30
DEALHUNTER_SHOPEE_MAX_CONCURRENCY=3
DEALHUNTER_RAW_EVIDENCE_RETENTION=false

# Telegram alerts (optional)
DEALHUNTER_TELEGRAM_BOT_TOKEN=
DEALHUNTER_TELEGRAM_CHAT_ID=

# Development affiliate adapter; replace with official provider adapter/credentials when available.
DEALHUNTER_AFFILIATE_PROVIDER=generic
DEALHUNTER_AFFILIATE_KEY=aff_id
DEALHUNTER_AFFILIATE_VALUE=demo

# Keep false until an authorized account/session adapter is configured.
DEALHUNTER_ACCOUNT_VERIFICATION_ENABLED=false
