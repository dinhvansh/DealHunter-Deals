DEALHUNTER_ENV=local
DEALHUNTER_DATABASE_URL=postgresql+psycopg://dealhunter:dealhunter@postgres:5432/dealhunter
DEALHUNTER_REDIS_URL=redis://redis:6379/0

DEALHUNTER_SHOPEE_BASE_URL=https://shopee.vn
# http = direct public API; chrome = Google Chrome Stable + persistent profile
DEALHUNTER_SHOPEE_TRANSPORT=chrome
DEALHUNTER_SHOPEE_TIMEOUT_SECONDS=30
DEALHUNTER_SHOPEE_MAX_CONCURRENCY=3
DEALHUNTER_RAW_EVIDENCE_RETENTION=false

# Google Chrome Stable browser session. Docker Compose persists this directory in a volume.
DEALHUNTER_CHROME_PROFILE_DIR=/data/chrome-profile
DEALHUNTER_CHROME_HEADLESS=true
# Leave blank to use Playwright channel="chrome". Set only for a custom host installation.
DEALHUNTER_CHROME_EXECUTABLE_PATH=
# Optional URL shown by Settings > Shopee Account for the noVNC login browser.
DEALHUNTER_BROWSER_LOGIN_PUBLIC_URL=http://localhost:6080/vnc.html?autoconnect=true

# First-run/auth secrets. If SECRET_KEY is blank, DealHunter creates this file once and reuses it.
# Docker mounts /secrets separately so the browser-login container cannot read the master key.
DEALHUNTER_SECRET_KEY=
DEALHUNTER_SECRET_KEY_FILE=/secrets/master.key
DEALHUNTER_SESSION_DAYS=30
# Set true when DealHunter itself is served over HTTPS.
DEALHUNTER_SESSION_COOKIE_SECURE=false

# Browser-login noVNC password. Change this on every deployment.
DEALHUNTER_VNC_PASSWORD=change-me-now
DEALHUNTER_BROWSER_LOGIN_PORT=6080

# Legacy env fallbacks. Production UI settings are stored encrypted in PostgreSQL.
DEALHUNTER_TELEGRAM_BOT_TOKEN=
DEALHUNTER_TELEGRAM_CHAT_ID=
DEALHUNTER_AFFILIATE_PROVIDER=generic
DEALHUNTER_AFFILIATE_KEY=aff_id
DEALHUNTER_AFFILIATE_VALUE=demo

# Keep false until an authorized account/session adapter is configured.
DEALHUNTER_ACCOUNT_VERIFICATION_ENABLED=false
